# Copy these into Vercel → Project acqua-website → Settings → Environment Variables (Production).
# Never commit real values.

# --- Stripe (the account that should receive acquatelecom.com shop payments)
STRIPE_SECRET_KEY=sk_live_...
# From Stripe → Developers → Webhooks → endpoint https://www.acquatelecom.com/api/stripe-webhook
STRIPE_WEBHOOK_SECRET=whsec_...

# --- Bridge4IP / eSIMVault OCS (travel eSIM provisioning)
OCS_BASE_URL=https://<your eSIMVault OCS host>
OCS_TOKEN=<api_key_b4ip>
# Account id that holds the free travel eSIM stock: run `npm run ocs:accounts`
OCS_ACCOUNT_ID=0

# --- Email (Postmark server token; sender domain must be verified in Postmark)
POSTMARK_SERVER_TOKEN=...
MAIL_FROM="Acqua Telecom <esim@acquatelecom.com>"
MAIL_REPLY_TO=support@acquatelecom.com
# Internal copy of every order; also where orders land when they need manual fulfilment
ORDERS_NOTIFY=ra@acquatelecom.com

SITE_URL=https://www.acquatelecom.com
